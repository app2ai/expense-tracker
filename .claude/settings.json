{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wenv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_db.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wenv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_code.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

